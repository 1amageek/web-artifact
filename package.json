{
  "name": "web-artifact",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "src/styles.css"
  ],
  "main": "./dist/web-artifact.umd.cjs",
  "module": "./dist/web-artifact.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/web-artifact.js",
      "require": "./dist/web-artifact.umd.cjs"
    },
    "./styles.css": "./dist/web-artifact.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "build:storybook": "storybook build",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.4.2",
    "@storybook/react-vite": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^15.0.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^10.4.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.8"
  }
}
