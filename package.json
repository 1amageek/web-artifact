{
  "name": "web-artifact",
  "description": "React component library for rendering LLM-generated artifact blocks.",
  "version": "0.1.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1amageek/web-artifact.git"
  },
  "bugs": {
    "url": "https://github.com/1amageek/web-artifact/issues"
  },
  "homepage": "https://github.com/1amageek/web-artifact#readme",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/web-artifact.umd.cjs",
  "module": "./dist/web-artifact.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/web-artifact.js",
      "require": "./dist/web-artifact.umd.cjs"
    },
    "./styles.css": "./dist/web-artifact.css"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:storybook": "storybook build",
    "pack:dry-run": "npm pack --dry-run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run build && npm run build:storybook && npm run pack:dry-run"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.4.2",
    "@storybook/react-vite": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^15.0.7",
    "@types/node": "^20.19.41",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^10.4.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.8"
  }
}
